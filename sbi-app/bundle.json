{"files":[{"path":"README.md","lines":9,"content":["# Synthetic outbreak posterior","","This example is synthetic and was prepared for an SBI provenance demonstration. The figure below shows a posterior estimate of the transmission rate, conditional on 21 daily reported infection counts.","","![Posterior](posterior.png)","","**Figure caption:** The simulated outbreak assumes 70% reporting. The shaded histogram is the FMPE posterior estimate, not a confidence guarantee.","","This is a synthetic demonstration. Do not infer that the posterior is statistically adequate from a successful replay."]},{"path":"simulator.py","lines":25,"content":["\"\"\"Stochastic discrete-time SIR simulator with binomial case reporting.","","This is a synthetic illustration, not a validated epidemiological model.","\"\"\"","import numpy as np","","","def simulate(beta, config, rng):","    \"\"\"Return one time series of reported new infections for a fixed beta.\"\"\"","    population = config[\"population\"]","    susceptible = population - config[\"initial_infectious\"]","    infectious = config[\"initial_infectious\"]","    reported = []","    for _ in range(config[\"days\"]):","        infections = rng.binomial(susceptible, 1.0 - np.exp(-beta * infectious / population))","        recoveries = rng.binomial(infectious, 1.0 - np.exp(-config[\"recovery_rate_per_day\"]))","        reported.append(int(rng.binomial(infections, config[\"reporting_fraction\"])))","        susceptible -= infections","        infectious += infections - recoveries","    return np.asarray(reported, dtype=np.float32)","","","def represent(counts):","    \"\"\"Use all 21 reported daily counts, scaled by 100, as FMPE input.\"\"\"","    return np.asarray(counts, dtype=np.float32) / 100.0"]},{"path":"config.json","lines":25,"content":["{","  \"description\": \"Synthetic stochastic epidemic; illustrative only\",","  \"population\": 500,","  \"initial_infectious\": 5,","  \"days\": 21,","  \"recovery_rate_per_day\": 0.15,","  \"reporting_fraction\": 0.5,","  \"transmission_prior_per_day\": [","    0.1,","    0.55","  ],","  \"synthetic_true_transmission_per_day\": 0.34,","  \"representation\": \"21 daily reported new infections divided by 100\",","  \"num_simulations\": 2048,","  \"simulation_seed\": 1729,","  \"observation_seed\": 2026,","  \"training_seed\": 7331,","  \"sampling_seed\": 314159,","  \"training_batch_size\": 128,","  \"max_num_epochs\": 200,","  \"stop_after_epochs\": 15,","  \"posterior_samples\": 128,","  \"comparison_atol\": 1e-05,","  \"comparison_rtol\": 1e-05","}"]},{"path":"run_manifest.json","lines":65,"content":["{","  \"experiment_type\": \"synthetic single-round flow-matching posterior estimation (FMPE)\",","  \"synthetic_only\": true,","  \"effective_config\": {","    \"description\": \"Synthetic stochastic epidemic; illustrative only\",","    \"population\": 500,","    \"initial_infectious\": 5,","    \"days\": 21,","    \"recovery_rate_per_day\": 0.15,","    \"reporting_fraction\": 0.5,","    \"transmission_prior_per_day\": [","      0.1,","      0.55","    ],","    \"synthetic_true_transmission_per_day\": 0.34,","    \"representation\": \"21 daily reported new infections divided by 100\",","    \"num_simulations\": 2048,","    \"simulation_seed\": 1729,","    \"observation_seed\": 2026,","    \"training_seed\": 7331,","    \"sampling_seed\": 314159,","    \"training_batch_size\": 128,","    \"max_num_epochs\": 200,","    \"stop_after_epochs\": 15,","    \"posterior_samples\": 128,","    \"comparison_atol\": 1e-05,","    \"comparison_rtol\": 1e-05","  },","  \"software_versions\": {","    \"python\": \"3.11.0\",","    \"numpy\": \"2.4.6\",","    \"torch\": \"2.15.0\",","    \"sbi\": \"0.27.0\",","    \"scipy\": \"1.17.1\",","    \"matplotlib\": \"3.11.2\"","  },","  \"platform\": \"macOS-26.6.2-arm64-arm-64bit\",","  \"architecture\": \"arm64\",","  \"device\": \"cpu\",","  \"torch_num_threads\": 1,","  \"estimator_architecture\": \"FlowMatchingEstimator(\\n  (net): VectorFieldMLP(\\n    (input_layer): Linear(in_features=1, out_features=100, bias=True)\\n    (condition_layer): Linear(in_features=21, out_features=100, bias=True)\\n    (input_merge_layer): Linear(in_features=200, out_features=100, bias=True)\\n    (time_emb): SinusoidalTimeEmbedding()\\n    (activation): GELU(approximate='none')\\n    (layers): ModuleList(\\n      (0-4): 5 x Linear(in_features=100, out_features=100, bias=True)\\n    )\\n    (layers_norm): ModuleList(\\n      (0-4): 5 x LayerNorm((100,), eps=1e-05, elementwise_affine=True, bias=True)\\n    )\\n    (time_linear_layer): Linear(in_features=32, out_features=100, bias=True)\\n    (output_layer): Linear(in_features=100, out_features=1, bias=True)\\n  )\\n  (_embedding_net): Sequential(\\n    (0): Standardize()\\n    (1): Identity()\\n  )\\n)\",","  \"training_result\": {","    \"epochs_trained\": 105,","    \"reached_epoch_cap\": false,","    \"diagnostics_run\": []","  },","  \"sampler\": {","    \"method\": \"sbi VectorFieldPosterior default ODE\",","    \"sampling_seed\": 314159,","    \"sample_count\": 128","  },","  \"command\": \"experiment/.venv/bin/python experiment/bundle/training.py\",","  \"prepared_duration_seconds\": 3.735,","  \"sha256\": {","    \"config.json\": \"142419c81f65b184858443f6ee9ec92196244eb2fc8b307ac5e93117766bfb06\",","    \"simulator.py\": \"a8481e478457d8a2fe355f8232b4f78f5a53885fcfc57da66950957e3acc6c5f\",","    \"training.py\": \"249a2f707b3013b5159226bf987a174fbd77ad49328157d064677b43ec6c8303\",","    \"sampling.py\": \"52421a2a2650c2cd2357c49ad8bd80f0d34cefdd8b22261dfea9b99a1418f3c9\",","    \"observation.json\": \"e29ba86e2461818cd97a6bf1f5ae640fb6814f75d5bec311c5fe91e14789b730\",","    \"posterior.pt\": \"a3a10dcbdbb80b38086dde4e8a67a759fbd9b46f2bcc528ce63483ab4066e184\",","    \"posterior_samples.npy\": \"12cf43b337b366633ff5c98248fce88f17dca4cdf4af9fa5ac1189e90b060bd0\",","    \"posterior.png\": \"10a7082a25ed3abb41388d87913c48585e611cc9480f7f0aa4d7e7d6df82e002\"","  },","  \"limitations\": \"Synthetic demonstration. A matching replay does not establish calibration, identifiability, or real-world validity.\"","}"]},{"path":"observation.json","lines":28,"content":["{","  \"type\": \"synthetic daily reported infection counts\",","  \"counts\": [","    0,","    0,","    1,","    2,","    3,","    2,","    1,","    3,","    0,","    1,","    3,","    3,","    6,","    8,","    6,","    6,","    6,","    8,","    9,","    3,","    10","  ],","  \"seed\": 2026,","  \"synthetic_true_transmission_per_day\": 0.34","}"]},{"path":"training.py","lines":91,"content":["\"\"\"Generate the synthetic outbreak FMPE fixture; training is not run during judging.","","Run from the project root: experiment/.venv/bin/python experiment/bundle/training.py","\"\"\"","import hashlib","import json","import os","import platform","import sys","import time","from pathlib import Path","","# Keep execution and sampling reproducible on the recorded CPU environment.","os.environ.setdefault(\"OMP_NUM_THREADS\", \"1\")","import matplotlib","matplotlib.use(\"Agg\")","import matplotlib.pyplot as plt","import numpy as np","import scipy","import sbi","import torch","from sbi.inference import FMPE","from sbi.utils import BoxUniform","from simulator import simulate, represent","from sampling import posterior_draws","","ROOT = Path(__file__).resolve().parent","","","def sha256(path):","    return hashlib.sha256(path.read_bytes()).hexdigest()","","","def main():","    start = time.monotonic()","    torch.set_num_threads(1)","    torch.use_deterministic_algorithms(True)","    config = json.loads((ROOT / \"config.json\").read_text())","    obs = simulate(config[\"synthetic_true_transmission_per_day\"], config,","                   np.random.default_rng(config[\"observation_seed\"]))","    observation = {\"type\": \"synthetic daily reported infection counts\", \"counts\": obs.astype(int).tolist(),","                   \"seed\": config[\"observation_seed\"], \"synthetic_true_transmission_per_day\": config[\"synthetic_true_transmission_per_day\"]}","    (ROOT / \"observation.json\").write_text(json.dumps(observation, indent=2) + \"\\n\")","    rng = np.random.default_rng(config[\"simulation_seed\"])","    low, high = config[\"transmission_prior_per_day\"]","    theta = rng.uniform(low, high, size=(config[\"num_simulations\"], 1)).astype(np.float32)","    x = np.stack([represent(simulate(float(value), config, rng)) for value in theta[:, 0]])","    prior = BoxUniform(low=torch.tensor([low]), high=torch.tensor([high]))","    torch.manual_seed(config[\"training_seed\"])","    inference = FMPE(prior=prior, device=\"cpu\", show_progress_bars=False)","    estimator = inference.append_simulations(torch.from_numpy(theta), torch.from_numpy(x)).train(","        training_batch_size=config[\"training_batch_size\"],","        max_num_epochs=config[\"max_num_epochs\"], stop_after_epochs=config[\"stop_after_epochs\"],","        show_train_summary=False)","    posterior = inference.build_posterior(estimator)","    # This object is generated locally and replayed only from the fixed, hashed bundle.","    torch.save(posterior, ROOT / \"posterior.pt\")","    x_o = torch.from_numpy(represent(obs)).unsqueeze(0)","    draws = posterior_draws(posterior, x_o, config)","    np.save(ROOT / \"posterior_samples.npy\", draws, allow_pickle=False)","    plt.figure(figsize=(6.4, 3.6))","    plt.hist(draws[:, 0], bins=22, color=\"#198a7e\", alpha=.8, density=True)","    plt.axvline(config[\"synthetic_true_transmission_per_day\"], color=\"#b35145\", linestyle=\"--\", label=\"Synthetic generating value\")","    plt.xlabel(\"Transmission rate per day\")","    plt.ylabel(\"Estimated posterior density\")","    plt.title(\"Prepared FMPE posterior · synthetic outbreak\")","    plt.legend(frameon=False)","    plt.tight_layout()","    plt.savefig(ROOT / \"posterior.png\", dpi=150)","    plt.close()","    files = [\"config.json\", \"simulator.py\", \"training.py\", \"sampling.py\", \"observation.json\", \"posterior.pt\", \"posterior_samples.npy\", \"posterior.png\"]","    manifest = {","        \"experiment_type\": \"synthetic single-round flow-matching posterior estimation (FMPE)\",","        \"synthetic_only\": True,","        \"effective_config\": config,","        \"software_versions\": {\"python\": platform.python_version(), \"numpy\": np.__version__, \"torch\": torch.__version__, \"sbi\": sbi.__version__, \"scipy\": scipy.__version__, \"matplotlib\": matplotlib.__version__},","        \"platform\": platform.platform(), \"architecture\": platform.machine(), \"device\": \"cpu\", \"torch_num_threads\": 1,","        \"estimator_architecture\": str(estimator),","        \"training_result\": {\"epochs_trained\": int(inference.epoch), \"reached_epoch_cap\": bool(inference.epoch >= config[\"max_num_epochs\"]), \"diagnostics_run\": []},","        \"sampler\": {\"method\": \"sbi VectorFieldPosterior default ODE\", \"sampling_seed\": config[\"sampling_seed\"], \"sample_count\": config[\"posterior_samples\"]},","        \"command\": \"experiment/.venv/bin/python experiment/bundle/training.py\",","        \"prepared_duration_seconds\": round(time.monotonic() - start, 3),","        \"sha256\": {name: sha256(ROOT / name) for name in files},","        \"limitations\": \"Synthetic demonstration. A matching replay does not establish calibration, identifiability, or real-world validity.\"","    }","    (ROOT / \"run_manifest.json\").write_text(json.dumps(manifest, indent=2) + \"\\n\")","    print(json.dumps({\"status\": \"prepared\", \"duration_seconds\": manifest[\"prepared_duration_seconds\"]}))","","","if __name__ == \"__main__\":","    main()"]},{"path":"sampling.py","lines":7,"content":["\"\"\"Trusted sampling routine shared by fixture generation and replay.\"\"\"","import torch","","","def posterior_draws(posterior, observation, config):","    torch.manual_seed(config[\"sampling_seed\"])","    return posterior.sample((config[\"posterior_samples\"],), x=observation, show_progress_bars=False).detach().cpu().numpy()"]}],"figure":"./posterior.png","manifest":{"experiment_type":"synthetic single-round flow-matching posterior estimation (FMPE)","synthetic_only":true,"effective_config":{"description":"Synthetic stochastic epidemic; illustrative only","population":500,"initial_infectious":5,"days":21,"recovery_rate_per_day":0.15,"reporting_fraction":0.5,"transmission_prior_per_day":[0.1,0.55],"synthetic_true_transmission_per_day":0.34,"representation":"21 daily reported new infections divided by 100","num_simulations":2048,"simulation_seed":1729,"observation_seed":2026,"training_seed":7331,"sampling_seed":314159,"training_batch_size":128,"max_num_epochs":200,"stop_after_epochs":15,"posterior_samples":128,"comparison_atol":0.00001,"comparison_rtol":0.00001},"software_versions":{"python":"3.11.0","numpy":"2.4.6","torch":"2.15.0","sbi":"0.27.0","scipy":"1.17.1","matplotlib":"3.11.2"},"platform":"macOS-26.6.2-arm64-arm-64bit","architecture":"arm64","device":"cpu","torch_num_threads":1,"estimator_architecture":"FlowMatchingEstimator(\n  (net): VectorFieldMLP(\n    (input_layer): Linear(in_features=1, out_features=100, bias=True)\n    (condition_layer): Linear(in_features=21, out_features=100, bias=True)\n    (input_merge_layer): Linear(in_features=200, out_features=100, bias=True)\n    (time_emb): SinusoidalTimeEmbedding()\n    (activation): GELU(approximate='none')\n    (layers): ModuleList(\n      (0-4): 5 x Linear(in_features=100, out_features=100, bias=True)\n    )\n    (layers_norm): ModuleList(\n      (0-4): 5 x LayerNorm((100,), eps=1e-05, elementwise_affine=True, bias=True)\n    )\n    (time_linear_layer): Linear(in_features=32, out_features=100, bias=True)\n    (output_layer): Linear(in_features=100, out_features=1, bias=True)\n  )\n  (_embedding_net): Sequential(\n    (0): Standardize()\n    (1): Identity()\n  )\n)","training_result":{"epochs_trained":105,"reached_epoch_cap":false,"diagnostics_run":[]},"sampler":{"method":"sbi VectorFieldPosterior default ODE","sampling_seed":314159,"sample_count":128},"command":"experiment/.venv/bin/python experiment/bundle/training.py","prepared_duration_seconds":3.735,"sha256":{"config.json":"142419c81f65b184858443f6ee9ec92196244eb2fc8b307ac5e93117766bfb06","simulator.py":"a8481e478457d8a2fe355f8232b4f78f5a53885fcfc57da66950957e3acc6c5f","training.py":"249a2f707b3013b5159226bf987a174fbd77ad49328157d064677b43ec6c8303","sampling.py":"52421a2a2650c2cd2357c49ad8bd80f0d34cefdd8b22261dfea9b99a1418f3c9","observation.json":"e29ba86e2461818cd97a6bf1f5ae640fb6814f75d5bec311c5fe91e14789b730","posterior.pt":"a3a10dcbdbb80b38086dde4e8a67a759fbd9b46f2bcc528ce63483ab4066e184","posterior_samples.npy":"12cf43b337b366633ff5c98248fce88f17dca4cdf4af9fa5ac1189e90b060bd0","posterior.png":"10a7082a25ed3abb41388d87913c48585e611cc9480f7f0aa4d7e7d6df82e002"},"limitations":"Synthetic demonstration. A matching replay does not establish calibration, identifiability, or real-world validity."},"config":{"description":"Synthetic stochastic epidemic; illustrative only","population":500,"initial_infectious":5,"days":21,"recovery_rate_per_day":0.15,"reporting_fraction":0.5,"transmission_prior_per_day":[0.1,0.55],"synthetic_true_transmission_per_day":0.34,"representation":"21 daily reported new infections divided by 100","num_simulations":2048,"simulation_seed":1729,"observation_seed":2026,"training_seed":7331,"sampling_seed":314159,"training_batch_size":128,"max_num_epochs":200,"stop_after_epochs":15,"posterior_samples":128,"comparison_atol":0.00001,"comparison_rtol":0.00001},"observation":{"type":"synthetic daily reported infection counts","counts":[0,0,1,2,3,2,1,3,0,1,3,3,6,8,6,6,6,8,9,3,10],"seed":2026,"synthetic_true_transmission_per_day":0.34},"variant":"mismatch"}